# Copy to `.env` (never commit `.env`) and fill in. `just` and `docker compose` load it automatically.

# --- Cloudflare R2: shared DVC remote (milestone M2) ---
R2_ACCOUNT_ID=
R2_BUCKET=vbtso-data
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Local MinIO for development and tests (milestone M2) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-locally

# --- Hugging Face Hub: publishing datasets and weights ---
HF_TOKEN=

# --- Roboflow (annotation) ---
ROBOFLOW_API_KEY=

# --- Integration ---
WEBHOOK_URL=

# --- Camera stream. Keep credentials here, never in code or notebooks. ---
RTSP_URL=
