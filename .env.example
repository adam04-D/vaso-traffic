# Copy to `.env` (never commit `.env`) and fill in. `just` loads it automatically.

# --- Cloudflare R2: DVC remote `r2` ---
# R2 speaks the S3 protocol, so DVC reads the standard AWS variables below.
# On Kaggle/Colab set the same three variables from their Secrets.
R2_BUCKET=vbtso-data
AWS_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- MLflow: local tracking server started with `just mlflow` ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- Hugging Face Hub: downloading BMD-45, publishing weights later ---
HF_TOKEN=

# --- Roboflow (legacy CCTV.v9 export) ---
ROBOFLOW_API_KEY=
