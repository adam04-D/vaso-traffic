# Copy to `.env` (never commit `.env`) and fill in. `just` and `docker compose` load it automatically.

# --- Cloudflare R2: shared DVC remote `r2` (milestone M2) ---
# R2 speaks the S3 protocol, so DVC reads the standard AWS variables below.
# On Kaggle/Colab set the same three variables from their Secrets.
R2_BUCKET=vbtso-data
AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Local S3-compatible dev store: DVC remote `local` (milestone M2) ---
# No credentials needed (it accepts any). Pin an exact image tag after the first successful `just up`.
# S3MOCK_IMAGE=

# --- Hugging Face Hub: publishing datasets and weights ---
HF_TOKEN=

# --- Roboflow (annotation) ---
ROBOFLOW_API_KEY=

# --- Integration ---
WEBHOOK_URL=

# --- Camera stream. Keep credentials here, never in code or notebooks. ---
RTSP_URL=
